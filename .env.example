# Teaching Planning Assistant Configuration

# Required Settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/tpa
SECRET_KEY=your_secret_key_generate_with_openssl_rand_hex_32

# Optional AI Settings
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_SECONDS=120
AI_MAX_OUTPUT_TOKENS=16000

# Optional Settings
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_API_KEY_PER_MINUTE=100

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080